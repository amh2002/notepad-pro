<dialogs:DialogWindow x:Class="NotepadPro.Dialogs.UnsavedChangesWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:dialogs="clr-namespace:NotepadPro.Dialogs"
                     xmlns:controls="clr-namespace:NotepadPro.Controls"
                     Title="Save changes?"
                     Width="500" SizeToContent="Height"
                     WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:DialogTitleBar Grid.Row="0" />

        <StackPanel Grid.Row="1" Margin="26,22,26,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="10" VerticalAlignment="Top"
                        Background="{DynamicResource App.WarningBackgroundBrush}">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource App.IconFontFamily}"
                               FontSize="21" Foreground="{DynamicResource App.WarningBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="SemiBold"
                               TextWrapping="Wrap" Foreground="{DynamicResource App.TextPrimaryBrush}" />
                    <TextBlock x:Name="DetailText" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource HintText}" Margin="0,18,0,0"
                       Text="Saving keeps your work in the original location. If you don't save, the changes will be lost." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" />
                <Button Content="Don't save" Click="Discard_Click" Margin="0,0,8,0" />
                <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</dialogs:DialogWindow>
