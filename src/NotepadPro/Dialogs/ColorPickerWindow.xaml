<dialogs:DialogWindow x:Class="NotepadPro.Dialogs.ColorPickerWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:dialogs="clr-namespace:NotepadPro.Dialogs"
                     xmlns:controls="clr-namespace:NotepadPro.Controls"
                     Title="Choose a color"
                     Width="470" SizeToContent="Height">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:DialogTitleBar Grid.Row="0" />

        <StackPanel Grid.Row="1" Margin="24,20,24,20">
            <TextBlock Text="Color value" Style="{StaticResource SectionHeaderText}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="HexBox" FontFamily="Cascadia Mono, Consolas" TextChanged="HexBox_TextChanged" />
                <Border Grid.Column="1" Width="48" Height="32" Margin="10,0,0,0" CornerRadius="5"
                        BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1">
                    <Border x:Name="PreviewBorder" CornerRadius="4" Background="White" />
                </Border>
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource App.DangerBrush}" FontSize="12"
                       Margin="0,6,0,0" Visibility="Collapsed"
                       Text="Enter a color as #RGB or #RRGGBB." />

            <TextBlock Text="Common colors" Style="{StaticResource SectionHeaderText}" Margin="0,18,0,6" />
            <WrapPanel x:Name="PalettePanel" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" />
                <Button Content="Use color" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</dialogs:DialogWindow>
