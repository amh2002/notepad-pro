<dialogs:DialogWindow x:Class="NotepadPro.Dialogs.MessageWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:dialogs="clr-namespace:NotepadPro.Dialogs"
                     xmlns:controls="clr-namespace:NotepadPro.Controls"
                     Title="Notepad Pro"
                     Width="500" SizeToContent="Height"
                     WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:DialogTitleBar Grid.Row="0" />

        <StackPanel Grid.Row="1" Margin="26,22,26,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBackground" Width="42" Height="42" CornerRadius="10" VerticalAlignment="Top"
                        Background="{DynamicResource App.InfoBarBackgroundBrush}">
                    <TextBlock x:Name="IconGlyph" Text="&#xE946;" FontFamily="{StaticResource App.IconFontFamily}"
                               FontSize="21" Foreground="{DynamicResource App.AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="SemiBold"
                               TextWrapping="Wrap" Foreground="{DynamicResource App.TextPrimaryBrush}" />
                    <TextBlock x:Name="MessageText" Style="{StaticResource HintText}" Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="Cancel_Click"
                        Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton" Content="OK" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</dialogs:DialogWindow>
