<dialogs:DialogWindow x:Class="NotepadPro.Dialogs.GoToLineWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:dialogs="clr-namespace:NotepadPro.Dialogs"
                     xmlns:controls="clr-namespace:NotepadPro.Controls"
                     Title="Go to line"
                     Width="400" SizeToContent="Height">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:DialogTitleBar Grid.Row="0" />

        <StackPanel Grid.Row="1" Margin="24,20,24,18">
            <TextBlock Text="Line number" Style="{StaticResource SectionHeaderText}" />
            <TextBox x:Name="LineBox" MinWidth="120" />
            <TextBlock x:Name="RangeText" Style="{StaticResource HintText}" Margin="0,7,0,0" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource App.DangerBrush}"
                       FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" />
                <Button Content="Go to line" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</dialogs:DialogWindow>
