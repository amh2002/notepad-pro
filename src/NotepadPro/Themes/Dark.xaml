<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Application shell: dark -->
    <SolidColorBrush x:Key="App.WindowBrush" Color="#202020" />
    <SolidColorBrush x:Key="App.SurfaceBrush" Color="#272727" />
    <SolidColorBrush x:Key="App.SurfaceAltBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="App.SurfaceRaisedBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="App.BorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="App.StrongBorderBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="App.TextPrimaryBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="App.TextSecondaryBrush" Color="#B4B4B4" />
    <SolidColorBrush x:Key="App.TextTertiaryBrush" Color="#858585" />
    <SolidColorBrush x:Key="App.AccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="App.AccentHoverBrush" Color="#7BD8FF" />
    <SolidColorBrush x:Key="App.AccentPressedBrush" Color="#4CB8E8" />
    <SolidColorBrush x:Key="App.AccentTextBrush" Color="#00263A" />
    <SolidColorBrush x:Key="App.SelectionBrush" Color="#2B4B6F" />
    <SolidColorBrush x:Key="App.HoverBrush" Color="#333333" />
    <SolidColorBrush x:Key="App.PressedBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="App.TitleBarBrush" Color="#202020" />
    <SolidColorBrush x:Key="App.TabActiveBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="App.TabInactiveBrush" Color="#252525" />
    <SolidColorBrush x:Key="App.TabHoverBrush" Color="#303030" />
    <SolidColorBrush x:Key="App.MenuBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="App.MenuBorderBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="App.MenuHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="App.StatusBarBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="App.StatusTextBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="App.DangerBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="App.DangerHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="App.SuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="App.WarningBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="App.WarningBackgroundBrush" Color="#3A3212" />
    <SolidColorBrush x:Key="App.CloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="App.InputBackgroundBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="App.InputBorderBrush" Color="#454545" />
    <SolidColorBrush x:Key="App.InputFocusBorderBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="App.ScrollThumbBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="App.ScrollThumbHoverBrush" Color="#6A6A6A" />
    <SolidColorBrush x:Key="App.DividerBrush" Color="#333333" />
    <SolidColorBrush x:Key="App.InfoBarBackgroundBrush" Color="#1B3A4B" />
    <SolidColorBrush x:Key="App.InfoBarBorderBrush" Color="#2A5A73" />
    <SolidColorBrush x:Key="App.OverlayBrush" Color="#99000000" />
    <SolidColorBrush x:Key="App.SearchHighlightBrush" Color="#8A6A1F" />

    <!-- Editor defaults (overridden at runtime by ThemeService) -->
    <SolidColorBrush x:Key="Editor.BackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Editor.ForegroundBrush" Color="#D4D4D4" />
    <SolidColorBrush x:Key="Editor.GutterBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Editor.LineNumberBrush" Color="#858585" />
    <SolidColorBrush x:Key="Editor.CurrentLineBrush" Color="#282828" />
    <SolidColorBrush x:Key="Editor.CurrentLineBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="Editor.SelectionBrush" Color="#264F78" />
    <SolidColorBrush x:Key="Editor.SelectionBorderBrush" Color="#3A6EA5" />
    <SolidColorBrush x:Key="Editor.IndentGuideBrush" Color="#404040" />
    <SolidColorBrush x:Key="Editor.BracketBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="Editor.BracketBackgroundBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Editor.SearchMatchBrush" Color="#613214" />
    <SolidColorBrush x:Key="Editor.SearchCurrentBrush" Color="#9E6A03" />
    <SolidColorBrush x:Key="Editor.CaretBrush" Color="#AEAFAD" />
    <SolidColorBrush x:Key="Editor.PanelBackgroundBrush" Color="#252526" />
    <SolidColorBrush x:Key="Editor.PanelBorderBrush" Color="#3F3F46" />
</ResourceDictionary>
